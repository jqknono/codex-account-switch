{
  "name": "codex-account-switch",
  "version": "1.8.6",
  "description": "Quick switch between multiple Codex CLI accounts",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqknono/codex-account-switch.git"
  },
  "homepage": "https://github.com/jqknono/codex-account-switch",
  "bugs": {
    "url": "https://github.com/jqknono/codex-account-switch/issues"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "codex-account-switch": "dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run build -w @codex-account-switch/core",
    "build": "tsc --emitDeclarationOnly && node ./scripts/build.mjs",
    "predev": "npm run build -w @codex-account-switch/core",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/**/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "codex",
    "cli",
    "account",
    "switch"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@codex-account-switch/core": "*",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
